{
  "expo": {
    "name": "Foldable Example",
    "slug": "react-native-adaptive-layout-example",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "scheme": "foldable-example",
    "platforms": ["ios"],
    "ios": {
      "bundleIdentifier": "dev.foldable.example",
      "supportsTablet": true
    },
    "plugins": [
      ["expo-build-properties", { "ios": { "enableSceneSupport": true } }]
    ]
  }
}
