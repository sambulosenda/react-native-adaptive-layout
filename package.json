{
  "name": "react-native-foldable",
  "version": "0.1.0",
  "description": "Adaptive split/overlay layouts and hinge-aware hooks for foldable devices in React Native.",
  "license": "MIT",
  "author": "Sambulo Senda <sambulosendas@gmail.com> (https://github.com/sambulosenda)",
  "homepage": "https://github.com/sambulosenda/react-native-foldable#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sambulosenda/react-native-foldable.git"
  },
  "bugs": {
    "url": "https://github.com/sambulosenda/react-native-foldable/issues"
  },
  "keywords": [
    "react-native",
    "foldable",
    "hinge",
    "ios",
    "swiftui",
    "adaptive-layout",
    "fabric",
    "iphone-duo"
  ],
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "react-native-foldable-source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "src",
    "lib",
    "ios",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "workspaces": [
    "example"
  ],
  "scripts": {
    "build": "bob build",
    "clean": "del-cli lib",
    "typecheck": "tsc",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "example": "yarn workspace react-native-foldable-example",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "yarn build && changeset publish",
    "prepare": "bob build && lefthook install"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.83.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.29.0",
    "@commitlint/cli": "^20.0.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@react-native/babel-preset": "0.86.2",
    "@types/node": "^24",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "del-cli": "^7.0.0",
    "lefthook": "^1.13.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-builder-bob": "^0.43.1",
    "react-test-renderer": "19.2.3",
    "turbo": "^2.10.8",
    "typescript": "^6.0.3",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@4.11.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "RNFoldableSpec",
    "type": "components",
    "jsSrcsDir": "src/native",
    "ios": {
      "components": {
        "RNFoldableLayout": {
          "className": "RNFoldableLayoutView"
        },
        "RNFoldablePane": {
          "className": "RNFoldablePaneView"
        }
      }
    }
  }
}
